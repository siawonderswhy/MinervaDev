---
const { words } = Astro.props
---

<div class="rotating-text">
  {words.map((word) => <span class="word">{word}</span>)}
</div>

<style>
  .rotating-text {
    display: flex;
    color: var(--accent-400);
    height: 100px;
  }
  
  .word {
    text-align: center;
    position: absolute;
    overflow: hidden;
    width: 100%;
    padding-bottom: 20px;
  }

  :global(.char-inline) {
    display: inline-block !important;
  }

  @media (max-width: 1000px) {
    .word {
      padding-bottom: 7px;
    }
    
  }
</style>
