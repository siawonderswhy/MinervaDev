---
import { Image } from "astro:assets"

import Head from "../layouts/BaseLayout.astro"
import "../css/home.css"
import logo from "../images/logo.svg"
import BreakTextLines from "../components/BreakTextLines.astro"
import BreakTextChars from "../components/BreakTextChars.astro"
import BreakTextLinesOnView from "../components/BreakTextLinesOnView.astro"
import BreakTextLinesScrub from "../components/BreakTextLinesScrub.astro"
// import myImg from "../images/under-construction.png"
// import heroGemTop from "../svg/HeroGemstoneTop.svg"

import YearsIcon from "../svg/YearsIcon.svg"
import ClientsIcon from "../svg/ClientsIcon.svg"
import CountriesIcon from "../svg/CountriesIcon.svg"
import ProjectsIcon from "../svg/ProjectsIcon.svg"
import Arrow from "../svg/Arrow.svg"
import LogoType from "../svg/LogoType.svg"
import GoogleDrive from "../svg/GoogleDrive.svg"

import Brochure from "../images/projects/Brochure.png"
import Banner from "../images/projects/Banner.png"
import Website from "../images/projects/Website.png"
import LogoDesign from "../images/projects/LogoDesign.png"
import Packaging from "../images/projects/Packaging.png"

import Branding from "../images/services/Branding.png"
import VisualIdentity from "../images/services/VisualIdentity.png"
import WebsiteService from "../images/services/Website.png"
import Prints from "../images/services/PrintedObjects.png"
import Photography from "../images/services/PhotoAndVideo.png"
import ContentCreation from "../images/services/ContentCreation.png"
---

<Head
  title="Minerva Studio | All Eyes on Your Brand"
  description="Minerva Studio delivers premium branding, logo design, and web solutions to elevate your business. Our expert team creates impactful brand identities and stunning websites that drive success."
  canonicalURL="https://minervastudio.co/"
  ogTitle="Minerva Studio"
  ogImage="/assets/og/homepage-og.jpg"
>
  <main>
    <div class="hero" id="home">
      <nav>
        <a href="/#home" class="logo">
          <img src={logo.src} alt="Minerva Studio Logo" />
        </a>
        <div class="nav-links">
          <a href="#contact">Let's Connect</a>
          <a href="">Menu</a>
        </div>
      </nav>

      <div class="hero-info-container">
        <div class="est">EST. 2024</div>
        <div class="minerva-studio-info">
          <BreakTextLines>
            <p>A creative Design studio</p>
          </BreakTextLines>

          <BreakTextLines>
            <p>based in Tehran/Iran</p>
          </BreakTextLines>
        </div>

        <div class="minerva-studio-headings">
          <BreakTextLines>
            <h1>All Eyes On Your</h1>
          </BreakTextLines>

          <BreakTextLines>
            <h1>
              <BreakTextChars
                words={[
                  "Brand",
                  "Logo",
                  "Catalog",
                  "Brochure",
                  "Website",
                  "Merchandise",
                  "Billboard",
                  "Info-Card",
                  "Teaser",
                  "Mascot",
                  "Brand",
                ]}
              />
            </h1>
          </BreakTextLines>
        </div>
      </div>

