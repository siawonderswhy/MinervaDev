  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const serviceTypes = document.querySelectorAll(".service-type")
      const serviceImage = document.getElementById("serviceImage")

      // Default image
      const defaultImage = serviceTypes[0].getAttribute("data-image")
      serviceImage.style.backgroundImage = `url(${defaultImage})`

      serviceTypes.forEach((service) => {
        service.addEventListener("mouseover", () => {
          const image = service.getAttribute("data-image")
          if (image) {
            serviceImage.classList.add("hidden")
            setTimeout(() => {
              serviceImage.style.backgroundImage = `url(${image})`
              serviceImage.classList.remove("hidden")
            }, 00) // Match the transition duration
          }
        })
      })

      document
        .querySelector(".services-list")
        .addEventListener("mouseleave", () => {
          serviceImage.classList.add("hidden")
          setTimeout(() => {
            serviceImage.style.backgroundImage = `url(${defaultImage})`
            serviceImage.classList.remove("hidden")
          }, 0)
        })
    })

    // Function to adjust the layout based on screen size
    function adjustIntroLayout() {
      const intro = document.querySelector(".intro")
      const introText = document.querySelector(".introduction-text")
      const introFeatures = document.querySelector(".introduction-features")

      // Check if elements exist
      if (!intro || !introText || !introFeatures) return

      // Get the viewport width
      const screenWidth = window.innerWidth

      if (screenWidth < 1000) {
        // Get the height of the "introduction-text" div
        const introTextHeight = introText.offsetHeight

        // Calculate the offset for "introduction-features"
        const offset = `calc(5vh + ${introTextHeight}px + 5vh)`
        introFeatures.style.top = offset

        // Get the height of "introduction-features"
        const featuresHeight = introFeatures.offsetHeight

        // Set the height of the "intro" div
        const totalHeight = `calc(5vh + ${introTextHeight}px + 5vh + ${featuresHeight}px + 5vh)`
        intro.style.height = totalHeight
      } else {
        // Reset styles when screen width is >= 1000px
        intro.style.height = ""
        introFeatures.style.top = ""
      }
    }

    // Attach the resize event listener
    window.addEventListener("resize", adjustIntroLayout)

    // Call the function on initial load
    adjustIntroLayout()
  </script>
